# ============================================================
# Faith Tribe — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored. .env.example is safe to commit.
# ============================================================

# ------------------------------------------------------------
# FIREBASE (Recommended — free Spark tier, never pauses)
# ------------------------------------------------------------
# Create a project at https://console.firebase.google.com
# Enable "Realtime Database" and set rules (see firebase.rules.json)
# Project Settings → Your Apps → Web App → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------
# SUPABASE (Legacy — kept for backward compatibility)
# Warning: free tier pauses after 7 days of inactivity
# ------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================
# Transport auto-selection order (when both are unset):
#   1. Firebase (if VITE_FIREBASE_* set)
#   2. Supabase (if VITE_SUPABASE_* set)
#   3. WebRTC P2P — works on local WiFi hotspot, no internet needed
# ============================================================
